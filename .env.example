# Copy this file to .env and fill in your actual values. Never commit .env.
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com"
GRAPHMIND_ANSWER_PROVIDER="ollama"
GRAPHMIND_ANSWER_MODEL="gemma4:31b-cloud"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# Authenticated browser/MCP service. Use HTTPS public URLs outside loopback development.
GRAPHMIND_PUBLIC_BASE_URL="https://rag.example.com"
GRAPHMIND_IDENTITY_ISSUER_URL="https://auth.example.com/realms/graphmind"
GRAPHMIND_IDENTITY_BROWSER_CLIENT_ID="graphmind-web"
GRAPHMIND_IDENTITY_BROWSER_CLIENT_SECRET=""
GRAPHMIND_IDENTITY_RESOURCE_CLIENT_ID="graphmind-resource"
GRAPHMIND_IDENTITY_RESOURCE_CLIENT_SECRET=""
GRAPHMIND_IDENTITY_ADMIN_CLIENT_ID="graphmind-admin"
# Host-account CLI only: omit this variable entirely from the public reader environment.
GRAPHMIND_IDENTITY_ADMIN_CLIENT_SECRET=""
GRAPHMIND_IDENTITY_REQUIRED_SCOPE="graphmind:read"
GRAPHMIND_IDENTITY_MCP_AUDIENCE="https://rag.example.com/mcp"
GRAPHMIND_IDENTITY_FLOW_SIGNING_KEY=""
GRAPHMIND_BROWSER_COOKIE_SECURE="true"
