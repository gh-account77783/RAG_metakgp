prune tests
include documentation/AUTH_AND_MCP.md documentation/DEPENDENCIES.md config/graphmind.example.toml config/.env.example
include documentation/ARCHITECTURE.md
include documentation/RELEASE_BUNDLES.md
include config/constraints/core-py313.txt
include config/constraints/linux-py313.txt
include config/constraints/engines-py313.txt
include config/artifacts/cpu-torch-cp313.json
recursive-include deploy/keycloak *.md *.json
include deploy/keycloak/nginx-recovery.conf.example
recursive-include deploy/keycloak/themes *.properties
recursive-include deploy/keycloak/recovery-src *.java
include deploy/keycloak/recovery-src/META-INF/services/org.keycloak.authentication.AuthenticatorFactory
include deploy/keycloak/recovery-src/META-INF/services/org.keycloak.events.EventListenerProviderFactory
include deploy/acceptance/README.md
include tools/run_real_acceptance.py tools/mcp_acceptance.py tools/build_keycloak_recovery.py
include tools/build_assets.py
include assets/web/graphmind.css assets/web/graphmind.js
recursive-exclude * __pycache__ *.py[cod]
